# --- application -------------------------------------------------------------
ENVIRONMENT=development            # development | testing | production
LOG_LEVEL=INFO
LOG_JSON=true

# --- database ----------------------------------------------------------------
# PostgreSQL: postgresql+psycopg://user:password@host:5432/dbname
# MySQL:      mysql+pymysql://user:password@host:3306/dbname
# SQLite (local dev only): sqlite:///./security_incident.db
DATABASE_URL=mysql+pymysql://root:Hanvika%40061120@localhost/security_incident_db
AUTO_CREATE_TABLES=false           # dev convenience; use `alembic upgrade head` otherwise
SEED_ON_STARTUP=true               # idempotent: roles, permissions, SLA policies, first admin

# --- security (production REFUSES to start with the default secret/password) --
SECRET_KEY=change-me-in-production-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
RESET_TOKEN_EXPIRE_MINUTES=30
BCRYPT_ROUNDS=12
REGISTRATION_AUTO_ACTIVATE=false
EXPOSE_RESET_TOKEN=true            # simulated e-mail: returns the reset token in the response (dev only)
FIRST_SUPERADMIN_EMAIL=admin@example.com
FIRST_SUPERADMIN_PASSWORD=Admin@12345
FIRST_SUPERADMIN_NAME=System Administrator
CORS_ORIGINS=[]

# --- business rules ----------------------------------------------------------
DUPLICATE_ALERT_WINDOW_MINUTES=60
CORRELATION_WINDOW_MINUTES=120
CORRELATION_MIN_ALERTS=3
CORRELATION_LOOKBACK_HOURS=168
DUPLICATE_INCIDENT_WINDOW_HOURS=24
SLA_APPROACHING_FRACTION=0.25
REMEDIATION_DUE_SOON_HOURS=24

# --- workers / cache ---------------------------------------------------------
ENABLE_BACKGROUND_WORKERS=false
WORKER_INTERVAL_SECONDS=60
# REDIS_URL=redis://localhost:6379/0
DASHBOARD_CACHE_TTL_SECONDS=30
